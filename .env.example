# Copy this file to .env and fill in real values before deploying
# Generate a password hash by running: node hash-password.js "yourpassword"
APP_PASSWORD_HASH=
SESSION_SECRET=change-this-to-a-random-long-string
PORT=3000

# Days before the next call-in date to start flagging a medication as "due soon"
ALERT_LEAD_DAYS=3
