# Copy this file to .env and fill in real values before deploying
# Generate a password hash by running: node hash-password.js "yourpassword"
APP_PASSWORD_HASH=
SESSION_SECRET=change-this-to-a-random-long-string
PORT=3000

# Optional: only needed if you're using the mobile home screen widget.
# Any random string works — generate one with: openssl rand -hex 24
WIDGET_API_KEY=
