# Copy this file to .env and fill in your values.
# Generate the password hash with:  node hash-password.js "yourpassword"
# NOTE: if the hash contains "$" and you use docker compose, escape each "$" as "$$".

# ---------- Required ----------
APP_PASSWORD_HASH=
SESSION_SECRET=change-this-to-a-random-long-string   # e.g. openssl rand -hex 32
PORT=3000

# Public URL of your install (used in Discord reminder links)
APP_URL=https://health.megangibbs.net

# Your timezone (IANA name) — used for "today" and reminder schedules
REMINDER_TIMEZONE=America/Detroit

# ---------- Medication reminders ----------
# Days before the next call-in date to flag a medication as "due soon"
# (3 if the pharmacy still has refills on file, 5 if you need a new prescription)
ALERT_LEAD_DAYS_WITH_REFILL=3
ALERT_LEAD_DAYS_NO_REFILL=5

# Discord webhook for daily refill reminders. Leave blank to disable.
DISCORD_WEBHOOK_URL=

# Cron schedule for the daily check (5-field cron). Default: 8:00 AM daily
REMINDER_CRON_SCHEDULE=0 8 * * *

# ---------- Appointment reminders ----------
# Use a DIFFERENT webhook/channel than the medication one. Blank = disabled.
DISCORD_APPT_WEBHOOK_URL=
# Days before an appointment to send reminders
APPT_REMINDER_LEAD_DAYS=1,3

# ---------- Optional integrations ----------
# iOS Scriptable widget key:  openssl rand -hex 16   (blank = widget endpoint off)
WIDGET_API_KEY=
# Read-only appointments API for other apps:  openssl rand -hex 16  (blank = off)
APPT_API_KEY=
# Enables a no-login share link for the Emergency Info card:  openssl rand -hex 32
# Anyone with the link can see that card — treat the key like a password.
EMERGENCY_SHARE_KEY=
