# Copy this file to .env and fill in real values before deploying
# Generate a password hash by running: node hash-password.js "yourpassword"
APP_PASSWORD_HASH=
SESSION_SECRET=change-this-to-a-random-long-string
PORT=3000

# Days before the next call-in date to start flagging a medication as "due soon"
# Different lead time depending on whether a pharmacy refill is still available
ALERT_LEAD_DAYS_WITH_REFILL=3
ALERT_LEAD_DAYS_NO_REFILL=5

# Discord webhook URL for daily refill reminders. Leave blank to disable.
# Create one via: Discord channel Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=

# Cron schedule for the daily reminder check (standard 5-field cron syntax)
# Default: 8:00 AM every day
REMINDER_CRON_SCHEDULE=0 8 * * *

# Timezone for the reminder schedule
REMINDER_TIMEZONE=America/Detroit
